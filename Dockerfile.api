FROM node:22-bookworm-slim

WORKDIR /app

# Copy package descriptors
COPY package*.json ./
COPY packages/shared-types/package*.json ./packages/shared-types/
COPY packages/api-client/package*.json ./packages/api-client/
COPY services/api/package*.json ./services/api/

# Install only production dependencies
RUN npm install --omit=dev

# Copy compiled dist and runtime assets
COPY packages/shared-types/dist ./packages/shared-types/dist
COPY packages/api-client/dist ./packages/api-client/dist
COPY services/api/dist ./services/api/dist
COPY services/api/data ./services/api/data
COPY apps/web/public ./apps/web/public

WORKDIR /app/services/api

ENV NODE_ENV=production
ENV PORT=4000
ENV EVOLUTION_API_URL=http://teletrack-evolution-api:8080
ENV EVOLUTION_API_KEY=teletrack_evolution_secret_key_2026
ENV EVOLUTION_INSTANCE_NAME=teletrack-sales-bot

EXPOSE 4000

CMD ["node", "dist/server.js"]
