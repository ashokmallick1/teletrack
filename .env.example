# Callyzer SaaS Platform Environment Template
# Duplicate this file to .env and provide your deployment-specific configuration

# API Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_32_byte_secret_key

# PostgreSQL / Supabase Database
# For local dev without Postgres, leave empty to use instant in-memory store
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/callyzer_db

# Web Application
VITE_API_URL=http://localhost:4000
